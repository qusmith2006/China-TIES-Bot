            "required": [
              "variable"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  0,
                  1,
                  null
                ]
              },
              "candidate_codes": {
                "items": {
                  "properties": {
                    "code": {
                      "enum": [
                        0,
                        1,
                        null
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {

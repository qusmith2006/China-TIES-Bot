              }
            },
            "required": [
              "variable"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "minItems": 1
